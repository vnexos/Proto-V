{
  "Neo-ASM Program Template": {
    "prefix": "neoa-program",
    "body": [
      ".arch x86_64",
      ".text",
      ".global _start",
      "",
      "_start:",
      "    ; Initialize stack frame",
      "    PUSH fp",
      "    ASN fp, sp",
      "",
      "    ; Main logic",
      "    ASN r0, ${1:42}",
      "    ASN r1, ${2:10}",
      "    ADD r0, r0, r1",
      "",
      "    ; Exit sequence",
      "    ASN sp, fp",
      "    POP fp",
      "    origin(SYSCALL)",
      ""
    ],
    "description": "Standard Neo-ASM Program Entry Template"
  },
  "Conditional Branch": {
    "prefix": "jeq",
    "body": [
      "JEQ ${1:r0}, ${2:r1}, @${3:label}"
    ],
    "description": "Jump if Equal"
  },
  "Memory Assign": {
    "prefix": "asn-mem",
    "body": [
      "ASN [${1:fp} - ${2:8}], ${3:r0}"
    ],
    "description": "Store register into memory"
  },
  "Origin Passthrough": {
    "prefix": "origin",
    "body": [
      "origin(${1:SYSCALL})"
    ],
    "description": "Native CPU architecture command passthrough"
  }
}
