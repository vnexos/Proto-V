{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neo-ASM",
  "scopeName": "source.neoa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#labels" },
    { "include": "#directives" },
    { "include": "#origin_passthrough" },
    { "include": "#mnemonics" },
    { "include": "#registers" },
    { "include": "#numbers" },
    { "include": "#memory_addressing" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.assembly.neoa",
          "match": ";.*$"
        },
        {
          "name": "comment.line.double-slash.assembly.neoa",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.assembly.neoa",
          "match": "#.*$"
        },
        {
          "name": "comment.block.assembly.neoa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.assembly.neoa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.assembly.neoa",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.assembly.neoa",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.assembly.neoa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.assembly.neoa",
          "match": "^[ \\t]*([a-zA-Z_.$][a-zA-Z0-9_.$]*):",
          "captures": {
            "1": { "name": "entity.name.function.label.assembly.neoa" }
          }
        },
        {
          "name": "entity.name.tag.label.pic.assembly.neoa",
          "match": "@[a-zA-Z0-9_.]+"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.assembly.neoa",
          "match": "\\.(arch|text|data|bss|rodata|section|global|globl|extern|align|ascii|asciz|byte|word|dword|qword|space)\\b"
        }
      ]
    },
    "origin_passthrough": {
      "patterns": [
        {
          "begin": "\\b(origin)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "support.function.builtin.origin.assembly.neoa" },
            "2": { "name": "punctuation.definition.parameters.begin.assembly.neoa" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.assembly.neoa" }
          },
          "patterns": [
            {
              "name": "entity.name.command.native.assembly.neoa",
              "match": "[^)]+"
            }
          ]
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "name": "keyword.control.mnemonic.assign.assembly.neoa",
          "match": "(?i)\\bASN\\b"
        },
        {
          "name": "keyword.control.mnemonic.stack.assembly.neoa",
          "match": "(?i)\\b(PUSH|POP)\\b"
        },
        {
          "name": "keyword.control.mnemonic.arithmetic.assembly.neoa",
          "match": "(?i)\\b(ADD|SUB|MUL|DIV|MOD|NEG|UDIV|UMOD|ADD32|SUB32|MUL32|DIV32|MOD32|UDIV32|UMOD32)\\b"
        },
        {
          "name": "keyword.control.mnemonic.bitwise.assembly.neoa",
          "match": "(?i)\\b(AND|OR|XOR|NOT|SHL|SHR|SAR|CLZ|AND32|OR32|XOR32|NOT32|SHL32|SHR32|SAR32|CLZ32)\\b"
        },
        {
          "name": "keyword.control.mnemonic.branch.assembly.neoa",
          "match": "(?i)\\b(JMP|JEQ|JNE|JGT|JGE|JLT|JLE|JUGT|JUGE|JULT|JULE|CALL|RET)\\b"
        },
        {
          "name": "keyword.control.mnemonic.system.assembly.neoa",
          "match": "(?i)\\b(SYS|BRK|NOP|FENCE)\\b"
        },
        {
          "name": "keyword.control.mnemonic.vector.assembly.neoa",
          "match": "(?i)\\b(VASN|VADD|VSUB|VMUL|VDIV|VAND|VOR|VXOR|VADD_I32|VSUB_I32|VMUL_I32|VADD_I64|VSUB_I64|VLOAD|VSTORE)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.virtual.assembly.neoa",
          "match": "(?i)\\br([0-9]|[12][0-9]|3[01])\\b"
        },
        {
          "name": "storage.type.register.system.assembly.neoa",
          "match": "(?i)\\b(sp|fp|zr)\\b"
        },
        {
          "name": "variable.language.register.native.x86.assembly.neoa",
          "match": "(?i)\\b(rax|rbx|rcx|rdx|rsi|rdi|rsp|rbp|r8|r9|r10|r11|r12|r13|r14|r15|eax|ebx|ecx|edx|esi|edi|esp|ebp)\\b"
        },
        {
          "name": "variable.language.register.native.arm.assembly.neoa",
          "match": "(?i)\\b([xw]([0-9]|[12][0-9]|3[01])|lr|xzr|wzr)\\b"
        },
        {
          "name": "variable.language.register.native.riscv.assembly.neoa",
          "match": "(?i)\\b(zero|ra|gp|tp|t[0-6]|s[0-9]|s1[01]|a[0-7])\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.assembly.neoa",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.bin.assembly.neoa",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.oct.assembly.neoa",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.assembly.neoa",
          "match": "\\b[+-]?[0-9][0-9_]*\\b"
        }
      ]
    },
    "memory_addressing": {
      "patterns": [
        {
          "name": "meta.memory-operand.assembly.neoa",
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.bracket.memory.begin.assembly.neoa" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.bracket.memory.end.assembly.neoa" }
          },
          "patterns": [
            { "include": "#registers" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#labels" }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.assembly.neoa",
          "match": "[-+*\\/&|^~]"
        },
        {
          "name": "punctuation.separator.delimiter.assembly.neoa",
          "match": "[,:]"
        }
      ]
    }
  }
}
